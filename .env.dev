# ============================================================================
# Global development defaults
#
# Purpose:       Settings shared by the whole deployment: what this server
#                runs (roles), Compose project name, internal network, backup
#                directory and time zone of every container.
# Role:          Project-level env file. Its values are used in the root
#                compose.yaml and reach every included stack, overriding keys
#                with the same name in the stacks' env files.
# Prerequisites: Compose only reads this file when COMPOSE_ENV_FILES is set in
#                the shell, once per machine:
#                  Linux/macOS (~/.bashrc):  export COMPOSE_ENV_FILES=.env.dev,.env
#                  Windows (PowerShell):     setx COMPOSE_ENV_FILES ".env.dev,.env"
#                A root .env must also exist (may be empty) for local
#                overrides. Without COMPOSE_ENV_FILES, Compose stops with
#                "project name must not be empty".
# Format:        KEY=value, one per line. No quotes needed. Keep comments on
#                their own lines.
# ============================================================================

# ----------------------------------------------------------------------------
# Server roles
# ----------------------------------------------------------------------------
# COMPOSE_PROFILES: what this server runs. Every service belongs to a profile;
# `docker compose up -d` starts only the services of the profiles listed here,
# so each server runs the same committed files with its own list in the root
# .env. With no profile, Compose starts nothing ("no service selected").
# Format: comma-separated profiles, no spaces:
#   vpn-host          WireGuard server (on the server with the primaries)
#   vpn-client        WireGuard peer of another server's VPN host
#   http              nginx gateway for public web apps
#   monitoring        PMM Server, PMM client + cAdvisor, Dozzle
#     pmm / metrics / logs   only PMM Server / PMM client + cAdvisor / Dozzle
#   primary           MySQL and PostgreSQL primaries
#   replica           MySQL and PostgreSQL replicas
#   backup            backups of the replicas (next to them) + log streams
#   admin             phpMyAdmin and pgAdmin
#     mysql-primary, postgres-primary, mysql-replica, postgres-replica,
#     mysql-backup, postgres-backup, mysql-admin, postgres-admin
#                     the same, for one engine only
#   apps              every app under apps/
#     java-service-example, angular-app-example   one app only
# Examples:
#   everything on one server (default):
#     vpn-host,http,monitoring,primary,replica,backup,admin
#   primary server, replicas elsewhere:  vpn-host,http,monitoring,primary,admin
#   replica server:                      vpn-client,replica,backup
# Stopping services of a profile no longer listed:
#   docker compose --profile <profile> down
COMPOSE_PROFILES=vpn-host,http,monitoring,primary,replica,backup,admin

# ----------------------------------------------------------------------------
# Compose project
# ----------------------------------------------------------------------------
# PROJECT_NAME: prefix of every container, volume and default resource name
# (e.g. services-mysql-db-1, services_mysql-data).
# Format: lowercase letters, digits, dashes and underscores. Default: services.
# Keep it stable: renaming it makes Compose create new, empty volumes and
# orphans the existing ones.
PROJECT_NAME=services

# ----------------------------------------------------------------------------
# Internal network
# ----------------------------------------------------------------------------
# NETWORK_NAME: Docker network every service joins.
# Format: Docker network name. Default: services-internal-network.
NETWORK_NAME=services-internal-network

# NETWORK_SUBNET: address range of the internal network. VPN clients route it
# through the tunnel (VPN_ALLOWED_IPS in gateway/.env.dev uses this value).
# Format: IPv4 CIDR. Default: 172.30.0.0/16. Must not overlap with VPN_SUBNET
# or the networks of the server and VPN clients. Changing it requires
# recreating the network and regenerating VPN client configs.
# On a server running the VPN client, use a different subnet than the VPN host
# (e.g. 172.31.0.0/16).
NETWORK_SUBNET=172.30.0.0/16

# VPN_DNS_IP: fixed address of the VPN host container on the VPN host's
# internal network. Its DNS server resolves the VPN host's service names
# (mysql-primary, mysql-db, pmm-server, ...). Replicas use it, so they find
# the primary whether it runs on the same server or on the VPN host.
# Format: IPv4 inside the VPN host's NETWORK_SUBNET, at the top of the range so
# it never collides with automatically assigned addresses.
# Default: 172.30.255.2. Same value on every server.
VPN_DNS_IP=172.30.255.2

# ----------------------------------------------------------------------------
# Backups
# ----------------------------------------------------------------------------
# BACKUP_DIR: directory on this server where the backup profile writes, one
# subfolder per engine (mysql/, postgres/). Use a separate disk in production.
# Format: absolute path (e.g. /srv/backups, or D:/backups on Docker Desktop).
# Default: empty, meaning ./backups inside each backup stack
# (databases/<engine>/backup/backups/<engine>, not committed).
# MYSQL_BACKUP_DIR / POSTGRES_BACKUP_DIR in the stacks' .env override it.
BACKUP_DIR=

# ----------------------------------------------------------------------------
# Time zone
# ----------------------------------------------------------------------------
# TZ: time zone of every container (logs, local time in the databases).
# Format: IANA zone name (e.g. Europe/Lisbon). Default: Etc/UTC.
# Images without time zone data (pmm-client, cAdvisor, Dozzle) stay on UTC.
# PostgreSQL keeps the zone it was initialized with; MySQL follows it on
# restart. UTC is recommended: the web UIs show times in the browser's zone.
TZ=Etc/UTC
