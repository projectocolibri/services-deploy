# ============================================================================
# Deployment settings
#
# Purpose:       The one settings file of the deployment: project name, what
#                this server runs (profiles), the internal network and the
#                settings of every service.
# Role:          Template with development defaults. Each server has its own
#                copy named .env next to compose.yaml, which Docker Compose
#                loads automatically; every variable in it reaches every
#                stack. .env is not committed.
# Prerequisites: - Copy this file once per server and edit the copy:
#                    cp .env.example .env
#                - Replace every "development only" password before the first
#                  start in production: users and passwords are created when
#                  a data volume is first initialized, so changing them later
#                  does not change the existing database.
#                - COMPOSE_ENV_FILES must NOT be set in the shell: when it is,
#                  Compose reads the files it names instead of .env.
# Format:        KEY=value, one per line. No quotes needed. Keep comments on
#                their own lines. An empty value means "not set".
#                ${VAR} references a key defined earlier in this file.
#                New keys added here must be copied to each server's .env.
# ============================================================================


# ############################################################################
# 1. PROJECT
# ############################################################################

# PROJECT_NAME: prefix of every container, volume and default resource name
# (e.g. services-mysql-db-1, services_mysql-data).
# Format: lowercase letters, digits, dashes and underscores. Default: services.
# Keep it stable: renaming it makes Compose create new, empty volumes and
# orphans the existing ones.
PROJECT_NAME=services


# ############################################################################
# 2. PROFILES (what this server runs)
# ############################################################################
# COMPOSE_PROFILES: every service has its own profile, and
# `docker compose up -d` starts only the services whose profile is listed
# here. Every server runs the same committed files with its own list. With no
# profile, Compose starts nothing ("no service selected").
# Format: comma-separated profiles, no spaces.
#
#   Profile               Starts                                                  Section
#   --------------------  ------------------------------------------              -------
#   Gateway
#   vpn-host              WireGuard server (with the primaries)                   4.2
#   vpn-client            WireGuard peer of another server's host                 4.3
#   http                  nginx gateway for public web apps                       4.4
#
#   Monitoring
#   pmm                   PMM Server                                              4.5
#   metrics               PMM client + cAdvisor                                   4.6
#   logs                  Dozzle                                                  4.7
#   portainer             Portainer                                               4.8
#
#   MySQL
#   mysql-primary         primary, read/write                                     4.9
#   mysql-replica         read-only replica                                       4.9
#   mysql-backup          XtraBackup + binary log stream (next to the replica)    4.9
#   mysql-admin           phpMyAdmin                                              4.9
#
#   PostgreSQL
#   postgres-primary      primary, read/write                                     4.10
#   postgres-replica      read-only hot standby                                   4.10
#   postgres-backup       pg_basebackup + WAL stream (next to the replica)        4.10
#   postgres-admin        pgAdmin                                                 4.10
#
#   Apps
#   java-service-example  Java service example                                    4.11
#   angular-app-example   Angular SSR app example                                 4.11
#   nodejs-app-example    Node.js app example                                     4.11
#
# Examples:
#   everything on one server (default):
#     vpn-host,http,pmm,metrics,logs,portainer,mysql-primary,mysql-replica,
#     mysql-backup,mysql-admin,postgres-primary,postgres-replica,
#     postgres-backup,postgres-admin
#   primary server, replicas elsewhere:
#     vpn-host,http,pmm,metrics,logs,portainer,mysql-primary,mysql-admin,
#     postgres-primary,postgres-admin
#   replica server:
#     vpn-client,mysql-replica,mysql-backup,postgres-replica,postgres-backup
#   (write the list on one line, without spaces or line breaks)
#
# Enable either vpn-host or vpn-client on a server, never both.
# Stopping a service whose profile was removed from the list:
#   docker compose --profile <profile> down
COMPOSE_PROFILES=vpn-host,http,pmm,metrics,logs,portainer,mysql-primary,mysql-replica,mysql-backup,mysql-admin,postgres-primary,postgres-replica,postgres-backup,postgres-admin


# ############################################################################
# 3. NETWORK
# ############################################################################

# NETWORK_NAME: Docker network every service joins. Containers reach each other
# by service name and alias (mysql-primary, postgres-replica, ...).
# Format: Docker network name. Default: services-internal-network.
NETWORK_NAME=services-internal-network

# NETWORK_SUBNET: address range of the internal network. VPN clients route it
# through the tunnel (see VPN_ALLOWED_IPS).
# Format: IPv4 CIDR. Default: 172.30.0.0/16. Must not overlap with VPN_SUBNET
# or the networks of the server and VPN clients. Changing it requires
# recreating the network and regenerating VPN client configs.
# On a server running the VPN client, use a different subnet than the VPN host
# (e.g. 172.31.0.0/16).
NETWORK_SUBNET=172.30.0.0/16

# VPN_DNS_IP: fixed address of the VPN host container on the VPN host's
# internal network. Its DNS server resolves the VPN host's service names
# (mysql-primary, postgres-primary, pmm-server, ...). Replicas and backups use
# it, so they find the primary whether it runs on the same server or on the
# VPN host.
# Format: IPv4 inside the VPN host's NETWORK_SUBNET, at the top of the range so
# it never collides with automatically assigned addresses.
# Default: 172.30.255.2. Same value on every server.
VPN_DNS_IP=172.30.255.2


# ############################################################################
# 4. SERVICES
# ############################################################################

# ============================================================================
# 4.1 General (every container)
# ============================================================================

# TZ: time zone of every container (logs, local time in the databases).
# Format: IANA zone name (e.g. Europe/Lisbon). Default: Etc/UTC.
# Images without time zone data (pmm-client, cAdvisor, Dozzle, XtraBackup)
# stay on UTC. PostgreSQL keeps the zone it was initialized with; MySQL follows
# it on restart. UTC is recommended: the web UIs show times in the browser's
# zone.
TZ=Etc/UTC


# ============================================================================
# 4.2 Gateway: VPN host (WireGuard server)          profile: vpn-host
# ============================================================================

# VPN_HOST: public IP address or DNS name of this server. Written into every
# client config as the endpoint clients connect to.
# Format: hostname or IPv4. Default: localhost (only useful for local tests).
# Changing it requires regenerating client configs (delete
# gateway/vpn/host/config/peer_* and restart the vpn service).
VPN_HOST=localhost

# VPN_PORT: UDP port published on the host for WireGuard. Open it in the
# firewall.
# Format: port number. Default: 51820.
VPN_PORT=51820

# VPN_PEERS: VPN clients to create: people and other servers. One key pair,
# config file and QR code is generated per name in
# gateway/vpn/host/config/peer_<name>/.
# Format: comma-separated names (letters and digits only, no dashes), or a
# number to create that many numbered peers. Default: admin.
VPN_PEERS=admin

# VPN_SUBNET: address range assigned inside the tunnel. The server takes .1
# and clients take .2, .3, ... in order.
# Format: IPv4 network address ending in .0 (a /24 is used).
# Default: 10.13.13.0. Must not overlap with NETWORK_SUBNET or the clients'
# networks.
VPN_SUBNET=10.13.13.0

# VPN_ALLOWED_IPS: networks clients send through the tunnel (split tunnel).
# Everything else, including normal internet traffic, bypasses the VPN.
# Format: comma-separated CIDR list. Default: the VPN subnet plus the internal
# Docker network.
VPN_ALLOWED_IPS=${VPN_SUBNET}/24,${NETWORK_SUBNET}


# ============================================================================
# 4.3 Gateway: VPN client (WireGuard peer)          profile: vpn-client
# ============================================================================
# Used on servers that join another server's VPN host. The connection itself
# comes from gateway/vpn/client/config/peer.conf, copied from the VPN host.

# VPN_CLIENT_INTERFACE: name of the WireGuard interface created on the host.
# Format: 1-15 letters, digits, dashes or underscores. Default: wg-services.
VPN_CLIENT_INTERFACE=wg-services

# VPN_CLIENT_KEEPALIVE: seconds between keepalive packets to the VPN host,
# keeps the tunnel open through NAT and firewalls.
# Format: seconds. Default: 25.
VPN_CLIENT_KEEPALIVE=25

# VPN_CLIENT_ALLOWED_IPS: networks routed through the tunnel.
# Format: comma-separated CIDR list. Default: empty, uses AllowedIPs from
# peer.conf (the VPN host's VPN_ALLOWED_IPS).
VPN_CLIENT_ALLOWED_IPS=


# ============================================================================
# 4.4 Gateway: HTTP (nginx)                         profile: http
# ============================================================================

# HTTP_PORT: host TCP port published for plain HTTP (redirects to HTTPS).
# Format: port number. Default: 80.
HTTP_PORT=80

# HTTPS_PORT: host TCP port published for HTTPS.
# Format: port number. Default: 443.
HTTPS_PORT=443


# ============================================================================
# 4.5 Monitoring: PMM Server                        profile: pmm
# ============================================================================
# https://pmm-server:8443 through the VPN, user admin.

# PMM_ADMIN_PASSWORD: password of the PMM "admin" user, applied when PMM
# Server starts. The PMM client uses it to register this server.
# Format: string. Default: admin (development only).
PMM_ADMIN_PASSWORD=admin

# PMM_DATA_RETENTION: how long metrics and Query Analytics data are kept.
# Format: duration in hours with an h suffix. Default: 720h (30 days).
PMM_DATA_RETENTION=720h

# ----------------------------------------------------------------------------
# Alert email (Grafana SMTP inside PMM)
# ----------------------------------------------------------------------------
# Alert rules and contact points are configured in the PMM UI (Alerting).
# These settings only let PMM send email.

# ALERT_EMAIL_ENABLED: enables outgoing email.
# Format: true or false. Default: false.
ALERT_EMAIL_ENABLED=false

# SMTP_HOST: SMTP server hostname.
# Format: hostname. Default: smtp.example.com (placeholder).
SMTP_HOST=smtp.example.com

# SMTP_PORT: SMTP server port.
# Format: port number. Default: 587 (submission with STARTTLS).
SMTP_PORT=587

# SMTP_USER: SMTP login.
# Format: string. Default: empty (no authentication).
SMTP_USER=

# SMTP_PASSWORD: SMTP password.
# Format: string. Default: empty.
SMTP_PASSWORD=

# SMTP_FROM: sender address of alert emails.
# Format: email address. Default: pmm@example.com (placeholder).
SMTP_FROM=pmm@example.com

# ----------------------------------------------------------------------------
# Alert Slack (Grafana contact point "Slack")
# ----------------------------------------------------------------------------
# Creates the contact point "Slack" (monitoring/pmm/alerting/slack.yaml).
# Like email, which alerts are sent to it is configured in the PMM UI
# (Alerting > Notification policies). The contact point is read-only in the
# UI: change it here and restart pmm-server.

# ALERT_SLACK_ENABLED: creates the Slack contact point. false removes it on
# the next start, unless a notification policy still uses it (then it is kept
# and a warning is logged: remove it from the policy first).
# Format: true or false. Default: false.
ALERT_SLACK_ENABLED=false

# SLACK_WEBHOOK_URL: Slack incoming webhook (Slack app > Incoming Webhooks),
# which posts to the channel chosen when it was created. Secret.
# Format: https://hooks.slack.com/services/... Default: empty (required when
# ALERT_SLACK_ENABLED=true; if empty, Slack stays disabled).
SLACK_WEBHOOK_URL=


# ============================================================================
# 4.6 Monitoring: PMM client + cAdvisor             profile: metrics
# ============================================================================
# Registers this server, its containers and (optionally) the databases in
# PMM. It connects to the databases with MYSQL_MONITOR_USER and
# POSTGRES_MONITOR_USER (sections 4.9 and 4.10).

# MONITOR_SERVER_ADDRESS: address the PMM client connects to.
# Format: host:port. Default: pmm-server:8443 (PMM Server on this network, or
# on the VPN host through the VPN client).
MONITOR_SERVER_ADDRESS=pmm-server:8443

# MONITOR_DATABASES: whether this server's PMM client registers the databases
# (mysql-primary, mysql-replica, postgres-primary, postgres-replica) that are
# running anywhere on the network.
# Format: true or false. Default: true. With several servers, set true on one
# server only, or the databases are registered twice.
MONITOR_DATABASES=true


# ============================================================================
# 4.7 Monitoring: container logs (Dozzle)           profile: logs
# ============================================================================

# DOZZLE_MODE: role of this Dozzle instance.
# Format: empty or agent. Default: empty (web UI at http://dozzle:8080).
# agent: no UI, streams this server's logs on port 7007 to another server's UI.
DOZZLE_MODE=

# DOZZLE_REMOTE_AGENTS: other servers' agents shown in this web UI.
# Format: comma-separated host:port list (e.g. dozzle-agent:7007).
# Default: empty (this server only).
DOZZLE_REMOTE_AGENTS=


# ============================================================================
# 4.8 Monitoring: container management (Portainer) profile: portainer
# ============================================================================
# https://portainer:9443 through the VPN.

# PORTAINER_ADMIN_PASSWORD: password of the Portainer "admin" user, applied on
# the first start only (afterwards, change it in the UI).
# Format: string, at least 12 characters. Default: portainer-dev (development
# only).
PORTAINER_ADMIN_PASSWORD=portainer-dev


# ============================================================================
# 4.9 Databases: MySQL (Percona Server)
#      profiles: mysql-primary, mysql-replica, mysql-backup, mysql-admin
# ============================================================================

# ----------------------------------------------------------------------------
# Users (created on the primary at initialization; the replica is a clone of
# the primary, so it has the same users and passwords)
# ----------------------------------------------------------------------------

# MYSQL_ROOT_PASSWORD: password of the MySQL root account. Also used by the
# entrypoint scripts, health checks, backups and mysql-restore.sh.
# Format: string. Default: root (development only).
MYSQL_ROOT_PASSWORD=root

# MYSQL_USER: application user created on the primary. It gets no privileges
# on any database until they are granted (see MYSQL_DATABASES).
# Format: MySQL user name. Default: app.
MYSQL_USER=app

# MYSQL_USER_PASSWORD: password of MYSQL_USER.
# Format: string. Default: app (development only).
MYSQL_USER_PASSWORD=app

# MYSQL_REPLICATION_USER: account the replica uses to clone the primary
# (BACKUP_ADMIN) and to stream its binary log (REPLICATION SLAVE). The binary
# log backup stream uses it too.
# Format: MySQL user name. Default: replicator.
MYSQL_REPLICATION_USER=replicator

# MYSQL_REPLICATION_PASSWORD: password of MYSQL_REPLICATION_USER.
# Format: string. Default: replicator (development only).
MYSQL_REPLICATION_PASSWORD=replicator

# MYSQL_MONITOR_USER: read-only account PMM uses to collect metrics and query
# analytics. Created on the primary and used by the PMM client.
# Format: MySQL user name. Default: monitor.
MYSQL_MONITOR_USER=monitor

# MYSQL_MONITOR_PASSWORD: password of MYSQL_MONITOR_USER.
# Format: string. Default: monitor (development only).
MYSQL_MONITOR_PASSWORD=monitor

# ----------------------------------------------------------------------------
# Application databases
# ----------------------------------------------------------------------------

# MYSQL_DATABASES: databases created on the primary on every start, if they do
# not exist yet, with all privileges granted to MYSQL_USER. Empty: no database
# is created, they are created by hand or by the application. Set it when an
# app needs its databases ready on start, so a new server needs no manual
# CREATE DATABASE. Existing databases are never changed or dropped: removing a
# name only stops creating it. The replica gets them through replication.
# A name with % is a pattern: nothing is created, MYSQL_USER only gets all
# privileges on every matching database, including creating it. For example
# app% covers every database the application creates for itself (app_1,
# app_2...). Names are lowercase (--lower-case-table-names=1 on the server),
# so an app asking for MyApp gets myapp.
# Format: comma-separated lowercase names (letters, digits and _) or patterns
# (with %), e.g. app,shop_1,app%. Default: empty.
MYSQL_DATABASES=

# ----------------------------------------------------------------------------
# Replica
# ----------------------------------------------------------------------------

# MYSQL_REPLICA_PRIMARY_HOST: host the replica clones and follows, and the
# binary log stream connects to.
# Format: hostname. Default: mysql-primary (resolved through VPN_DNS_IP when
# the primary is on another server).
MYSQL_REPLICA_PRIMARY_HOST=mysql-primary

# ----------------------------------------------------------------------------
# Backups (profile mysql-backup, on the server with the replica)
# ----------------------------------------------------------------------------

# MYSQL_BACKUP_DIR: directory on this server where full backups (full/) and
# binary logs (binlog/) are written. Use a separate disk in production.
# Format: absolute path (e.g. /srv/backups/mysql, or D:/backups/mysql on
# Docker Desktop), or relative to databases/mysql/backup/.
# Default: ./backups/mysql (databases/mysql/backup/backups/mysql, not
# committed).
MYSQL_BACKUP_DIR=./backups/mysql

# MYSQL_BACKUP_SCHEDULE: when full backups run, in UTC (the XtraBackup image
# has no time zone data, so TZ does not apply). A failed backup is retried
# within the hour.
# Format: cron expression, 5 fields separated by spaces:
#   minute (0-59) hour (0-23) day-of-month (1-31) month (1-12) weekday (0-7,
#   0 and 7 are Sunday). Each field: * (any), a number, a range (1-5), a list
#   (1,15) or a step (*/6, 0-12/3). No names (MON, JAN).
# Examples: 0 2 * * * (every day 02:00), 0 */6 * * * (every 6 hours),
#   0 3 * * 0 (Sundays 03:00), 0 1 1 * * (first day of each month 01:00).
# Default: 0 2 * * * (every day at 02:00 UTC).
MYSQL_BACKUP_SCHEDULE=0 2 * * *

# MYSQL_BACKUP_RETENTION: how long full backups are kept. The newest backup is
# never removed. Binary logs are kept only back to the oldest remaining backup
# (older ones cannot be replayed), so point-in-time recovery covers the whole
# period. Logs moved aside after a primary change are removed once past it.
# Format: number followed by a unit: h (hours), d (days), w (weeks),
# M (calendar months) or y (years). Examples: 36h, 7d, 2w, 1M, 1y.
# Default: 7d.
MYSQL_BACKUP_RETENTION=7d

# MYSQL_BACKUP_VERIFY: after each backup, decompress and prepare a copy to
# prove it restores. Needs temporary disk for one uncompressed copy.
# Format: true or false. Default: true.
MYSQL_BACKUP_VERIFY=true

# MYSQL_BACKUP_THREADS: parallel threads for copying and compressing.
# Format: number. Default: 2.
MYSQL_BACKUP_THREADS=2

# MYSQL_BINLOG_SERVER_ID: server ID the binary log stream uses on the primary.
# Must differ from the primary (1), the replica (2) and any other stream.
# Format: number. Default: 101.
MYSQL_BINLOG_SERVER_ID=101

# ----------------------------------------------------------------------------
# Admin panel (phpMyAdmin, http://mysql-admin through the VPN)
# ----------------------------------------------------------------------------
# Users log in with MySQL credentials.

# MYSQL_ADMIN_HOSTS: MySQL servers offered on the phpMyAdmin login screen.
# Format: comma-separated hostnames. Default: the primary and the replica.
MYSQL_ADMIN_HOSTS=mysql-primary,mysql-replica

# MYSQL_ADMIN_HOSTS_LABELS: display names for MYSQL_ADMIN_HOSTS, same order.
# Format: comma-separated labels. Default: Primary,Replica.
MYSQL_ADMIN_HOSTS_LABELS=Primary,Replica

# MYSQL_ADMIN_UPLOAD_LIMIT: largest file phpMyAdmin accepts for imports.
# Format: size with unit (K, M, G). Default: 64M.
MYSQL_ADMIN_UPLOAD_LIMIT=64M


# ============================================================================
# 4.10 Databases: PostgreSQL (Percona Distribution)
#      profiles: postgres-primary, postgres-replica, postgres-backup,
#                postgres-admin
# ============================================================================

# ----------------------------------------------------------------------------
# Roles (created on the primary at initialization; the replica is a physical
# copy of the primary, so it has the same roles and passwords)
# ----------------------------------------------------------------------------

# POSTGRES_USER: superuser created at initialization. Also used by the
# primary's health check and init script.
# Format: PostgreSQL role name. Default: postgres.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: password of POSTGRES_USER.
# Format: string. Default: postgres (development only).
POSTGRES_PASSWORD=postgres

# POSTGRES_REPLICATION_USER: role with the REPLICATION attribute the replica
# uses to clone the primary (pg_basebackup) and stream WAL. The backups use it
# too.
# Format: PostgreSQL role name. Default: replicator.
POSTGRES_REPLICATION_USER=replicator

# POSTGRES_REPLICATION_PASSWORD: password of POSTGRES_REPLICATION_USER.
# Format: string. Default: replicator (development only).
POSTGRES_REPLICATION_PASSWORD=replicator

# POSTGRES_MONITOR_USER: read-only role (member of pg_monitor) PMM uses to
# collect metrics and query analytics. Created on the primary and used by the
# PMM client.
# Format: PostgreSQL role name. Default: monitor.
POSTGRES_MONITOR_USER=monitor

# POSTGRES_MONITOR_PASSWORD: password of POSTGRES_MONITOR_USER.
# Format: string. Default: monitor (development only).
POSTGRES_MONITOR_PASSWORD=monitor

# ----------------------------------------------------------------------------
# Application role and databases
# ----------------------------------------------------------------------------
# Created on the primary on every start, if they do not exist yet. Existing
# roles and databases are never changed or dropped: a new password here does
# not change an existing role, and removing a name only stops creating it.
# The replica gets them through replication.

# POSTGRES_APP_USER: login role for the applications, owner of every database
# in POSTGRES_DATABASES.
# Format: PostgreSQL role name. Default: app. Empty: no role is created and
# the databases are owned by POSTGRES_USER.
POSTGRES_APP_USER=app

# POSTGRES_APP_PASSWORD: password of POSTGRES_APP_USER.
# Format: string. Default: app (development only).
POSTGRES_APP_PASSWORD=app

# POSTGRES_DATABASES: databases created on the primary on every start, if they
# do not exist yet, owned by POSTGRES_APP_USER. Empty: no database is created,
# they are created by hand or by the application. Set it when an app needs its
# databases ready on start, so a new server needs no manual CREATE DATABASE.
# Format: comma-separated names (lowercase letters, digits and _), e.g.
# app,shop_1. Default: empty.
POSTGRES_DATABASES=

# ----------------------------------------------------------------------------
# Replica
# ----------------------------------------------------------------------------

# POSTGRES_REPLICA_PRIMARY_HOST: host the replica clones and streams from, and
# the backups connect to.
# Format: hostname. Default: postgres-primary (resolved through VPN_DNS_IP
# when the primary is on another server).
POSTGRES_REPLICA_PRIMARY_HOST=postgres-primary

# ----------------------------------------------------------------------------
# Backups (profile postgres-backup, on the server with the replica)
# ----------------------------------------------------------------------------

# POSTGRES_BACKUP_DIR: directory on this server where base backups (base/) and
# WAL (wal/) are written. Use a separate disk in production.
# Format: absolute path (e.g. /srv/backups/postgres, or D:/backups/postgres on
# Docker Desktop), or relative to databases/postgres/backup/.
# Default: ./backups/postgres (databases/postgres/backup/backups/postgres, not
# committed).
POSTGRES_BACKUP_DIR=./backups/postgres

# POSTGRES_BACKUP_SCHEDULE: when base backups run, in TZ. A failed backup is
# retried within the hour.
# Format: cron expression, 5 fields separated by spaces:
#   minute (0-59) hour (0-23) day-of-month (1-31) month (1-12) weekday (0-7,
#   0 and 7 are Sunday). Each field: * (any), a number, a range (1-5), a list
#   (1,15) or a step (*/6, 0-12/3). No names (MON, JAN).
# Examples: 0 2 * * * (every day 02:00), 0 */6 * * * (every 6 hours),
#   0 3 * * 0 (Sundays 03:00), 0 1 1 * * (first day of each month 01:00).
# Default: 30 2 * * * (every day at 02:30).
POSTGRES_BACKUP_SCHEDULE=30 2 * * *

# POSTGRES_BACKUP_RETENTION: how long base backups are kept. The newest backup
# is never removed. WAL is kept only back to the oldest remaining backup (older
# WAL cannot be replayed), so point-in-time recovery covers the whole period.
# WAL moved aside after a primary change is removed once past it.
# Format: number followed by a unit: h (hours), d (days), w (weeks),
# M (calendar months) or y (years). Examples: 36h, 7d, 2w, 1M, 1y.
# Default: 7d.
POSTGRES_BACKUP_RETENTION=7d

# POSTGRES_BACKUP_VERIFY: check every backup against its manifest with
# pg_verifybackup before packing it.
# Format: true or false. Default: true.
POSTGRES_BACKUP_VERIFY=true

# POSTGRES_WAL_SLOT: replication slot the WAL stream uses on the primary. The
# primary keeps WAL for it while the stream is down. If backups are removed for
# good, drop it on the primary: SELECT pg_drop_replication_slot('backup_wal');
# Format: lowercase letters, digits and underscores. Default: backup_wal.
POSTGRES_WAL_SLOT=backup_wal

# POSTGRES_MAX_SLOT_WAL_KEEP_SIZE: most WAL the primary keeps for a slot whose
# stream is down. Past it the slot is invalidated (point-in-time recovery gets a
# gap until the next base backup) instead of filling the primary's disk.
# Format: size with unit (MB, GB). Default: 10GB.
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# ----------------------------------------------------------------------------
# Admin panel (pgAdmin, http://postgres-admin through the VPN)
# ----------------------------------------------------------------------------

# POSTGRES_ADMIN_EMAIL: login email of the initial pgAdmin administrator.
# Format: email address. Default: admin@example.com. Only applied when the
# pgAdmin data volume is first created.
POSTGRES_ADMIN_EMAIL=admin@example.com

# POSTGRES_ADMIN_PASSWORD: password of the initial pgAdmin administrator.
# Format: string. Default: admin (development only). Only applied when the
# pgAdmin data volume is first created.
POSTGRES_ADMIN_PASSWORD=admin

# POSTGRES_ADMIN_HOSTS: PostgreSQL servers pre-registered in pgAdmin. The list
# is rebuilt on every start.
# Format: comma-separated hostnames. Default: the primary and the replica.
POSTGRES_ADMIN_HOSTS=postgres-primary,postgres-replica

# POSTGRES_ADMIN_HOSTS_LABELS: display names for POSTGRES_ADMIN_HOSTS, same
# order.
# Format: comma-separated labels. Default: Primary,Replica.
POSTGRES_ADMIN_HOSTS_LABELS=Primary,Replica

# POSTGRES_ADMIN_HOSTS_USER: role name pre-filled for every registered server
# (the password is asked on first connection).
# Format: PostgreSQL role name. Default: the value of POSTGRES_USER.
POSTGRES_ADMIN_HOSTS_USER=${POSTGRES_USER}


# ============================================================================
# 4.11 Apps
#      profiles: java-service-example, angular-app-example, nodejs-app-example
# ============================================================================
# Apps use TZ from section 4.1. Every other environment variable of an app
# is set here and passed by its compose.yaml (none in the Dockerfiles).

# ----------------------------------------------------------------------------
# Java service example                            profile: java-service-example
# ----------------------------------------------------------------------------

# JAVA_SERVICE_EXAMPLE_PORT: port the app's HTTP server listens on in the
# internal network (not published on the host). Must match the port set in
# the app itself; the gateway's proxy_pass must use it too:
# http://java-service-example:<port>.
# Format: port number. Required.
JAVA_SERVICE_EXAMPLE_PORT=8080

# JAVA_SERVICE_EXAMPLE_LANG: locale of the container. Older JVMs take
# file.encoding from it, so a UTF-8 locale keeps text in UTF-8.
# Format: locale name. Required.
JAVA_SERVICE_EXAMPLE_LANG=C.UTF-8

# ----------------------------------------------------------------------------
# Angular app example                              profile: angular-app-example
# ----------------------------------------------------------------------------

# ANGULAR_APP_EXAMPLE_NODE_ENV: mode of Express and Angular; production turns
# off debug output and enables caching.
# Format: production or development. Required.
ANGULAR_APP_EXAMPLE_NODE_ENV=production

# ANGULAR_APP_EXAMPLE_PORT: port the SSR server listens on in the internal
# network (not published on the host). The gateway's proxy_pass must use the
# same port: http://angular-app-example:<port>.
# Format: port number. Required.
ANGULAR_APP_EXAMPLE_PORT=8080

# ANGULAR_APP_EXAMPLE_ALLOWED_HOSTS: host names Angular renders for; requests
# for other hosts get 400 Bad Request. * allows any host: the HTTP gateway
# controls which domains reach the app (server_name).
# Format: comma-separated host names, or *. Required.
ANGULAR_APP_EXAMPLE_ALLOWED_HOSTS=*

# ANGULAR_APP_EXAMPLE_TRUST_PROXY_HEADERS: proxy headers trusted from the HTTP
# gateway; x-forwarded-proto lets pages know they are served over HTTPS.
# Format: comma-separated header names. Required.
ANGULAR_APP_EXAMPLE_TRUST_PROXY_HEADERS=x-forwarded-proto

# ----------------------------------------------------------------------------
# Node.js app example                               profile: nodejs-app-example
# ----------------------------------------------------------------------------

# NODEJS_APP_EXAMPLE_NODE_ENV: mode of the app and its libraries (Express,
# etc.); production turns off debug output and enables caching.
# Format: production or development. Required.
NODEJS_APP_EXAMPLE_NODE_ENV=production

# NODEJS_APP_EXAMPLE_PORT: port the app listens on in the internal network
# (not published on the host). The gateway's proxy_pass must use the same
# port: http://nodejs-app-example:<port>.
# Format: port number. Required.
NODEJS_APP_EXAMPLE_PORT=8080
