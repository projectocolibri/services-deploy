# ============================================================================
# nginx app config example
#
# Purpose:       Template for publishing one internal web app on its own
#                domain over HTTPS.
# Role:          Not loaded as-is (only *.conf files are). Copy it to
#                <app>.conf in this directory, adjust it, then reload nginx:
#                  docker compose exec http nginx -s reload
# Prerequisites: - DNS record for the domain pointing at this server
#                - Certificate files in
#                  gateway/http/certs/<domain>/fullchain.pem and privkey.pem
#                - The app container running on the internal network
#
# Values to replace:
#   app.example.com  public domain of the app (server_name and cert paths)
#   app:3000         internal service name and container port of the app
#   10m              maximum request body size (uploads)
#
# nginx variables used (set by nginx per request):
#   $host                      requested host name
#   $request_uri               original path and query string
#   $remote_addr               IP address of the client
#   $proxy_add_x_forwarded_for incoming X-Forwarded-For plus $remote_addr
#   $scheme                    http or https
#   $http_upgrade              client's Upgrade header (WebSocket handshake)
# ============================================================================

# ----------------------------------------------------------------------------
# HTTP to HTTPS redirect
# ----------------------------------------------------------------------------
server {
    listen 80;
    server_name app.example.com;
    # Permanent redirect to the same host and path over HTTPS.
    return 301 https://$host$request_uri;
}

# ----------------------------------------------------------------------------
# HTTPS server
# ----------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name app.example.com;

    # --- TLS ---------------------------------------------------------------
    # Certificate chain and private key for this domain, from
    # gateway/http/certs/app.example.com/.
    ssl_certificate     /etc/nginx/certs/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/app.example.com/privkey.pem;
    # Only modern TLS versions.
    ssl_protocols       TLSv1.2 TLSv1.3;

    # --- Request limits ----------------------------------------------------
    # Largest accepted request body; larger uploads get 413.
    client_max_body_size 10m;

    # --- Reverse proxy -----------------------------------------------------
    location / {
        # Internal service name and container port (plain HTTP inside Docker).
        proxy_pass http://app:3000;

        # HTTP/1.1 upstream connections (required for WebSockets).
        proxy_http_version 1.1;
        # Pass the original host, client IP and scheme to the app.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket upgrade support.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
}
