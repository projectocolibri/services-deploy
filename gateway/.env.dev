TZ=Etc/UTC

# VPN GATEWAY (WireGuard)
# Public IP or domain of this server (written into the client configs)
VPN_HOST=localhost
VPN_PORT=51820
# One client per name, comma separated. Configs: gateway/vpn/config/peer_<name>/
VPN_PEERS=filipe
VPN_SUBNET=10.13.13.0
# Networks routed through the VPN: VPN subnet + internal Docker network
# (subnet of the project network, fixed in the root compose.yaml)
VPN_ALLOWED_IPS=10.13.13.0/24,172.30.0.0/16

# HTTP GATEWAY (nginx)
HTTP_PORT=80
HTTPS_PORT=443
