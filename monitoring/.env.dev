# NETDATA
# Name of this server in Netdata (unique per server)
MONITOR_NODE_NAME=main

# Databases: read-only monitoring users created by the master init scripts
# (must match MYSQL_MONITOR_* / POSTGRES_MONITOR_* in databases/mysql and databases/postgres)
MONITOR_MYSQL_USER=monitor
MONITOR_MYSQL_PASSWORD=monitor
MONITOR_POSTGRES_USER=monitor
MONITOR_POSTGRES_PASSWORD=monitor

# ALERTS
# Email: recipients separated by spaces + SMTP server
ALERT_EMAIL_ENABLED=NO
ALERT_EMAILS=alerts@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=netdata@example.com
# Slack: incoming webhook (https://api.slack.com/messaging/webhooks) + channel
ALERT_SLACK_ENABLED=NO
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
