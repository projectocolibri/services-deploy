    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "description": "Asynchronous replication: a steady climb here means the replica cannot keep up with the primary.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
