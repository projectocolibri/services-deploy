    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "description": "Both must be RUNNING. Either one STOPPED means replication has broken.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "STOPPED"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "RUNNING"
                }
              },
              "type": "value"
            }
          ],
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
