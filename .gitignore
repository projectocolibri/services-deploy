# ============================================================================
# Git ignore rules
#
# Purpose:       Keeps secrets, generated keys, local overrides and editor
#                files out of version control.
# Role:          The settings template (.env.example) is committed; each
#                server keeps its real values in an uncommitted .env. VPN
#                keys, client configs and TLS certificates are generated or
#                installed on the server and must never be committed.
# Prerequisites: None.
# Variables:     None.
# ============================================================================

# ----------------------------------------------------------------------------
# Local environment overrides and secrets
# ----------------------------------------------------------------------------
# The root .env holds this server's profiles, production passwords and
# host-specific values. Created from .env.example.
.env
.version

# ----------------------------------------------------------------------------
# Database backups and their secrets
# ----------------------------------------------------------------------------
# Backups are kept in Docker volumes. This folder only holds output of the
# earlier backup system, if any.
databases/*/backup/backups/
# pgBackRest TLS certificates and keys, created by postgres-backup-server
# and copied to the replica's server.
databases/postgres/backup/certs/*
!databases/postgres/backup/certs/.gitkeep

# ----------------------------------------------------------------------------
# VPN gateway state (WireGuard)
# ----------------------------------------------------------------------------
# Host: server keys, peer keys and generated client configs are secrets
# created at runtime. Only the shared templates and the CoreDNS config are
# committed.
gateway/vpn/host/config/*
!gateway/vpn/host/config/templates/
!gateway/vpn/host/config/coredns/
# Client: peer.conf copied from the VPN host contains this server's private key.
gateway/vpn/client/config/*
!gateway/vpn/client/config/.gitkeep

# ----------------------------------------------------------------------------
# HTTP gateway certificates
# ----------------------------------------------------------------------------
# TLS certificates and private keys are installed per server. The .gitkeep
# placeholder keeps the (otherwise empty) directory in the repository.
gateway/http/certs/*
!gateway/http/certs/.gitkeep

# ----------------------------------------------------------------------------
# HTTP gateway active configuration
# ----------------------------------------------------------------------------
# Keep reusable nginx templates in Git, but keep the active deployment
# configuration local so an infrastructure update cannot replace routes,
# domains, upstreams, or certificate paths.
gateway/http/conf.d/*.conf
!gateway/http/conf.d/*.conf.example

# ----------------------------------------------------------------------------
# Machine-specific Compose overrides
# ----------------------------------------------------------------------------
# Loaded automatically by `docker compose`; used locally to publish internal
# tools on 127.0.0.1. Never deployed.
compose.override.yaml
compose.override.yml

# The committed example is a template for deployment-specific applications.
!compose.override.yaml.example

# ----------------------------------------------------------------------------
# Application source and local JRE archives
# ----------------------------------------------------------------------------
# Application exports, package sources, and Java runtimes are supplied by each
# deployment and are not part of the infrastructure repository.
apps/*/source/*
!apps/*/source/.gitkeep
apps/*/*.tar.gz

# ----------------------------------------------------------------------------
# Operating system and editor files
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
