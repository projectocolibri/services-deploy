# USERS
# Created on the master; the replica is a clone, so it has the same users.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by the replica (and backups) to stream WAL from the master
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator
# Read-only role for monitoring (must match MONITOR_POSTGRES_* in monitoring/.env.dev)
POSTGRES_MONITOR_USER=monitor
POSTGRES_MONITOR_PASSWORD=monitor

# REPLICA DATABASE
# Master to clone and follow
REPLICA_MASTER_HOST=postgres-db

# BACKUP (pg_basebackup, full + incremental)
# Database to back up (master: postgres-db, replica: postgres-replica)
BACKUP_HOST=postgres-db
# Needs the REPLICATION privilege
BACKUP_HOST_USER=${POSTGRES_REPLICATION_USER}
BACKUP_HOST_PASSWORD=${POSTGRES_REPLICATION_PASSWORD}
# Time between backups (sleep syntax: 30m, 4h, 1d)
BACKUP_INTERVAL=4h
POSTGRES_BACKUP_FOLDER=./backups

# ADMIN PANEL (pgAdmin)
# pgAdmin web UI (through the VPN): http://postgres-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# Servers offered in pgAdmin and their display names (comma separated, same order)
ADMIN_HOSTS=postgres-db,postgres-replica
ADMIN_HOSTS_LABELS=Master,Replica
ADMIN_HOSTS_USER=${POSTGRES_USER}
