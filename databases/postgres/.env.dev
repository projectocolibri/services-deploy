# ============================================================================
# PostgreSQL stack: development defaults
#
# Purpose:       Default credentials and settings for the PostgreSQL primary,
#                replica and pgAdmin.
# Role:          Loaded by databases/postgres/compose.yaml before
#                databases/postgres/.env, so any key set in .env overrides the
#                value here.
# Prerequisites: Put production passwords in databases/postgres/.env, never in
#                this committed file. Roles are created only when the primary's
#                data volume is first initialized: changing a role or password
#                here afterwards does not change the existing database.
# Format:        KEY=value, one per line. No quotes needed. Keep comments on
#                their own lines. ${VAR} references another key in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# Database roles
# ----------------------------------------------------------------------------
# Created on the primary at initialization. The replica is a physical copy of
# the primary, so it has the same roles and passwords.

# POSTGRES_USER: superuser created at initialization. Also used by the primary's
# health check and init script.
# Format: PostgreSQL role name. Default: postgres.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: password of POSTGRES_USER.
# Format: string. Default: postgres (development only).
POSTGRES_PASSWORD=postgres

# POSTGRES_REPLICATION_USER: role with the REPLICATION attribute the replica
# uses to clone the primary (pg_basebackup) and stream WAL.
# Format: PostgreSQL role name. Default: replicator.
POSTGRES_REPLICATION_USER=replicator

# POSTGRES_REPLICATION_PASSWORD: password of POSTGRES_REPLICATION_USER.
# Format: string. Default: replicator (development only).
POSTGRES_REPLICATION_PASSWORD=replicator

# POSTGRES_MONITOR_USER: read-only role (member of pg_monitor) PMM uses to
# collect metrics and query analytics. Must match MONITOR_POSTGRES_USER in
# monitoring/.env.dev.
# Format: PostgreSQL role name. Default: monitor.
POSTGRES_MONITOR_USER=monitor

# POSTGRES_MONITOR_PASSWORD: password of POSTGRES_MONITOR_USER. Must match
# MONITOR_POSTGRES_PASSWORD in monitoring/.env.dev.
# Format: string. Default: monitor (development only).
POSTGRES_MONITOR_PASSWORD=monitor

# ----------------------------------------------------------------------------
# Application role and databases
# ----------------------------------------------------------------------------
# Created on the primary on every start, if they do not exist yet. Existing
# roles and databases are never changed or dropped: a new password here does
# not change an existing role, and removing a name only stops creating it.
# The replica gets them through replication.

# POSTGRES_APP_USER: login role for the applications, owner of every database
# in POSTGRES_DATABASES.
# Format: PostgreSQL role name. Default: app. Empty: no role is created and
# the databases are owned by POSTGRES_USER.
POSTGRES_APP_USER=app

# POSTGRES_APP_PASSWORD: password of POSTGRES_APP_USER.
# Format: string. Default: app (development only).
POSTGRES_APP_PASSWORD=app

# POSTGRES_DATABASES: databases created on the primary on every start, if they
# do not exist yet, owned by POSTGRES_APP_USER. Empty here: no database is
# created, they are created by hand or by the application. Set it when an app
# needs its databases ready on start, so a new server needs no manual
# CREATE DATABASE.
# Format: comma-separated names (lowercase letters, digits and _), e.g.
# app,shop_1. Default: empty.
POSTGRES_DATABASES=

# ----------------------------------------------------------------------------
# Replica
# ----------------------------------------------------------------------------
# REPLICA_PRIMARY_HOST (optional, not set by default): host the replica clones
# and streams from. Format: hostname. Default when unset: postgres-primary.

# ----------------------------------------------------------------------------
# Backups (on the server running the replica)
# ----------------------------------------------------------------------------
# Base backups (base/) and WAL (wal/) are written to BACKUP_DIR/postgres, with
# BACKUP_DIR set in the root .env.dev.
# POSTGRES_BACKUP_DIR (optional, not set by default): a different directory for
# PostgreSQL only. Format: absolute path, or relative to
# databases/postgres/backup/. Default when unset: BACKUP_DIR/postgres.

# POSTGRES_BACKUP_TIME: daily time the base backup starts, in TZ.
# Format: HH:MM. Default: 02:30.
POSTGRES_BACKUP_TIME=02:30

# POSTGRES_BACKUP_RETENTION_DAYS: days base backups are kept. The newest backup
# is never removed, and WAL is kept back to the oldest remaining backup, so
# point-in-time recovery covers the whole period.
# Format: days. Default: 7.
POSTGRES_BACKUP_RETENTION_DAYS=7

# POSTGRES_BACKUP_VERIFY: check every backup against its manifest with
# pg_verifybackup before packing it.
# Format: true or false. Default: true.
POSTGRES_BACKUP_VERIFY=true

# POSTGRES_WAL_SLOT: replication slot the WAL stream uses on the primary. The
# primary keeps WAL for it while the stream is down. If backups are removed for
# good, drop it on the primary: SELECT pg_drop_replication_slot('backup_wal');
# Format: lowercase letters, digits and underscores. Default: backup_wal.
POSTGRES_WAL_SLOT=backup_wal

# POSTGRES_MAX_SLOT_WAL_KEEP_SIZE: most WAL the primary keeps for a slot whose
# stream is down. Past it the slot is invalidated (point-in-time recovery gets a
# gap until the next base backup) instead of filling the primary's disk.
# Format: size with unit (MB, GB). Default: 10GB.
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# ----------------------------------------------------------------------------
# Admin panel (pgAdmin, http://postgres-admin through the VPN)
# ----------------------------------------------------------------------------
# ADMIN_EMAIL: login email of the initial pgAdmin administrator.
# Format: email address. Default: admin@example.com. Only applied when the
# pgAdmin data volume is first created.
ADMIN_EMAIL=admin@example.com

# ADMIN_PASSWORD: password of the initial pgAdmin administrator.
# Format: string. Default: admin (development only). Only applied when the
# pgAdmin data volume is first created.
ADMIN_PASSWORD=admin

# ADMIN_HOSTS: PostgreSQL servers pre-registered in pgAdmin.
# Format: comma-separated hostnames. Default: the primary and the replica.
ADMIN_HOSTS=postgres-primary,postgres-replica

# ADMIN_HOSTS_LABELS: display names for ADMIN_HOSTS, in the same order.
# Format: comma-separated labels. Default: Primary,Replica.
ADMIN_HOSTS_LABELS=Primary,Replica

# ADMIN_HOSTS_USER: role name pre-filled for every registered server (the
# password is asked on first connection).
# Format: PostgreSQL role name. Default: the value of POSTGRES_USER.
ADMIN_HOSTS_USER=${POSTGRES_USER}
