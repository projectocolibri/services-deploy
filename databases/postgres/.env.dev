# MASTER DATABASE
MASTER_POSTGRES_USER=postgres
MASTER_POSTGRES_PASSWORD=postgres
# Role used by the replica (and backups) to stream WAL from the master
MASTER_REPLICATION_USER=replicator
MASTER_REPLICATION_PASSWORD=replicator

# REPLICA DATABASE
# Master to clone and follow
REPLICA_MASTER_HOST=postgres-db
REPLICA_POSTGRES_PASSWORD=${MASTER_POSTGRES_PASSWORD}

# BACKUP (pg_basebackup, full + incremental)
# Database to back up (master: postgres-db, replica: postgres-replica)
BACKUP_HOST=postgres-db
# Needs the REPLICATION privilege
BACKUP_HOST_USER=${MASTER_REPLICATION_USER}
BACKUP_HOST_PASSWORD=${MASTER_REPLICATION_PASSWORD}
# Time between backups (sleep syntax: 30m, 4h, 1d)
BACKUP_INTERVAL=4h
POSTGRES_BACKUP_FOLDER=./backups

# ADMIN PANEL (pgAdmin)
# pgAdmin web UI (through the VPN): http://postgres-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# Servers offered in pgAdmin and their display names (comma separated, same order)
ADMIN_HOSTS=postgres-db,postgres-replica
ADMIN_HOSTS_LABELS=Master,Replica
ADMIN_HOSTS_USER=${MASTER_POSTGRES_USER}

# MONITOR (PMM client -> shared PMM server in monitoring/pmm)
MONITOR_SERVER_ADDRESS=pmm-server:8443
MONITOR_ADMIN_PASSWORD=admin
# PostgreSQL instances to monitor and their names in PMM (comma separated, same order)
MONITOR_POSTGRES_HOSTS=postgres-db,postgres-replica
MONITOR_POSTGRES_NAMES=postgres-master,postgres-replica
# Accounts PMM uses to read metrics (comma separated, same order as the hosts;
# passwords must not contain commas)
MONITOR_POSTGRES_USERS=${MASTER_POSTGRES_USER},${MASTER_POSTGRES_USER}
MONITOR_POSTGRES_PASSWORDS=${MASTER_POSTGRES_PASSWORD},${MASTER_POSTGRES_PASSWORD}
