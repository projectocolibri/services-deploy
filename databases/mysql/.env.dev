# ============================================================================
# MySQL stack: development defaults
#
# Purpose:       Default credentials and settings for the MySQL primary,
#                replica and phpMyAdmin.
# Role:          Loaded by databases/mysql/compose.yaml before
#                databases/mysql/.env, so any key set in .env overrides the
#                value here.
# Prerequisites: Put production passwords in databases/mysql/.env, never in
#                this committed file. Users are created only when the primary's
#                data volume is first initialized: changing a user or password
#                here afterwards does not change the existing database.
# Format:        KEY=value, one per line. No quotes needed. Keep comments on
#                their own lines.
# ============================================================================

# ----------------------------------------------------------------------------
# Database users
# ----------------------------------------------------------------------------
# Created on the primary at initialization. The replica is a clone of the
# primary, so it has the same users and passwords.

# MYSQL_ROOT_PASSWORD: password of the MySQL root account. Also used by the
# entrypoint scripts and health checks of both primary and replica.
# Format: string. Default: root (development only).
MYSQL_ROOT_PASSWORD=root

# MYSQL_USER: application user created on the primary. It gets no privileges
# on any database until they are granted.
# Format: MySQL user name. Default: app.
MYSQL_USER=app

# MYSQL_USER_PASSWORD: password of MYSQL_USER.
# Format: string. Default: app (development only).
MYSQL_USER_PASSWORD=app

# MYSQL_REPLICATION_USER: account the replica uses to clone the primary
# (BACKUP_ADMIN) and to stream its binary log (REPLICATION SLAVE).
# Format: MySQL user name. Default: replicator.
MYSQL_REPLICATION_USER=replicator

# MYSQL_REPLICATION_PASSWORD: password of MYSQL_REPLICATION_USER.
# Format: string. Default: replicator (development only).
MYSQL_REPLICATION_PASSWORD=replicator

# MYSQL_MONITOR_USER: read-only account PMM uses to collect metrics and query
# analytics. Must match MONITOR_MYSQL_USER in monitoring/.env.dev.
# Format: MySQL user name. Default: monitor.
MYSQL_MONITOR_USER=monitor

# MYSQL_MONITOR_PASSWORD: password of MYSQL_MONITOR_USER. Must match
# MONITOR_MYSQL_PASSWORD in monitoring/.env.dev.
# Format: string. Default: monitor (development only).
MYSQL_MONITOR_PASSWORD=monitor

# ----------------------------------------------------------------------------
# Application databases
# ----------------------------------------------------------------------------
# MYSQL_DATABASES: databases created on the primary on every start, if they do
# not exist yet, with all privileges granted to MYSQL_USER. Empty here: no
# database is created, they are created by hand or by the application. Set it
# when an app needs its databases ready on start, so a new server needs no
# manual CREATE DATABASE. Existing databases are never changed or dropped:
# removing a name only stops creating it. The replica gets them through
# replication.
# A name with % is a pattern: nothing is created, MYSQL_USER only gets all
# privileges on every matching database, including creating it. For example
# app% covers every database the application creates for itself (app_1,
# app_2...). Names are lowercase (--lower-case-table-names=1 on the server),
# so an app asking for MyApp gets myapp.
# Format: comma-separated lowercase names (letters, digits and _) or patterns
# (with %), e.g. app,shop_1,app%. Default: empty.
MYSQL_DATABASES=

# ----------------------------------------------------------------------------
# Replica
# ----------------------------------------------------------------------------
# REPLICA_PRIMARY_HOST (optional, not set by default): host the replica clones
# and follows. Format: hostname. Default when unset: mysql-primary.

# ----------------------------------------------------------------------------
# Backups (on the server running the replica)
# ----------------------------------------------------------------------------
# Backups (full/) and binary logs (binlog/) are written to BACKUP_DIR/mysql,
# with BACKUP_DIR set in the root .env.dev.
# MYSQL_BACKUP_DIR (optional, not set by default): a different directory for
# MySQL only. Format: absolute path, or relative to databases/mysql/backup/.
# Default when unset: BACKUP_DIR/mysql.

# MYSQL_BACKUP_TIME: daily time the full backup starts, in UTC (the XtraBackup
# image has no time zone data, so TZ does not apply).
# Format: HH:MM. Default: 02:00.
MYSQL_BACKUP_TIME=02:00

# MYSQL_BACKUP_RETENTION_DAYS: days full backups are kept. The newest backup is
# never removed, and binary logs are kept back to the oldest remaining backup,
# so point-in-time recovery covers the whole period.
# Format: days. Default: 7.
MYSQL_BACKUP_RETENTION_DAYS=7

# MYSQL_BACKUP_VERIFY: after each backup, decompress and prepare a copy to
# prove it restores. Needs temporary disk for one uncompressed copy.
# Format: true or false. Default: true.
MYSQL_BACKUP_VERIFY=true

# MYSQL_BACKUP_THREADS: parallel threads for copying and compressing.
# Format: number. Default: 2.
MYSQL_BACKUP_THREADS=2

# MYSQL_BINLOG_SERVER_ID: server ID the binary log stream uses on the primary.
# Must differ from the primary (1), the replica (2) and any other stream.
# Format: number. Default: 101.
MYSQL_BINLOG_SERVER_ID=101

# ----------------------------------------------------------------------------
# Admin panel (phpMyAdmin, http://mysql-admin through the VPN)
# ----------------------------------------------------------------------------
# ADMIN_UPLOAD_LIMIT: largest file phpMyAdmin accepts for imports.
# Format: size with unit (K, M, G). Default: 64M.
ADMIN_UPLOAD_LIMIT=64M

# ADMIN_HOSTS: MySQL servers offered on the phpMyAdmin login screen.
# Format: comma-separated hostnames. Default: the primary and the replica.
ADMIN_HOSTS=mysql-primary,mysql-replica

# ADMIN_HOSTS_LABELS: display names for ADMIN_HOSTS, in the same order.
# Format: comma-separated labels. Default: Primary,Replica.
ADMIN_HOSTS_LABELS=Primary,Replica
