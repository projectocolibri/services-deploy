# MASTER DATABASE
MASTER_MYSQL_ROOT_PASSWORD=root
MASTER_MYSQL_USER=colibri
MASTER_MYSQL_USER_PASSWORD=colibri
MASTER_SERVER_ID=1
MASTER_LOG_BIN=mysql-bin
MASTER_BINLOG_FORMAT=ROW
# Role used by the replica to clone the master and stream its binary log
MASTER_REPLICATION_USER=replicator
MASTER_REPLICATION_PASSWORD=replicator

# REPLICA DATABASE
# Master to clone and follow
REPLICA_MASTER_HOST=mysql-db
# The replica is a clone of the master (same users): keep the master root password
REPLICA_MYSQL_ROOT_PASSWORD=${MASTER_MYSQL_ROOT_PASSWORD}
REPLICA_SERVER_ID=2
REPLICA_READ_ONLY=ON

# BACKUP (Percona XtraBackup, full + incremental)
# Database to back up (master: mysql-db / mysql-data, replica: mysql-replica / mysql-replica-data)
BACKUP_HOST=mysql-db
BACKUP_HOST_USER=root
BACKUP_HOST_PASSWORD=${MASTER_MYSQL_ROOT_PASSWORD}
# xtrabackup reads the data files: volume of BACKUP_HOST
BACKUP_HOST_VOLUME=mysql-data
# Time between backups (sleep syntax: 30m, 4h, 1d)
BACKUP_INTERVAL=4h
PERCONA_MYSQL_BACKUP_FOLDER=./backups

# ADMIN PANEL (phpMyAdmin)
# phpMyAdmin web UI (through the VPN): http://mysql-admin
ADMIN_UPLOAD_LIMIT=64M
# Servers offered on the login screen and their display names (comma separated, same order)
ADMIN_HOSTS=mysql-db,mysql-replica
ADMIN_HOSTS_LABELS=Master,Replica

# MONITOR (PMM client -> shared PMM server in monitoring/pmm)
MONITOR_SERVER_ADDRESS=pmm-server:8443
MONITOR_ADMIN_PASSWORD=admin
# MySQL instances to monitor and their names in PMM (comma separated, same order)
MONITOR_MYSQL_HOSTS=mysql-db,mysql-replica
MONITOR_MYSQL_NAMES=mysql-master,mysql-replica
# Accounts PMM uses to read metrics (comma separated, same order as the hosts;
# passwords must not contain commas)
MONITOR_MYSQL_USERS=root,root
MONITOR_MYSQL_PASSWORDS=${MASTER_MYSQL_ROOT_PASSWORD},${REPLICA_MYSQL_ROOT_PASSWORD}
